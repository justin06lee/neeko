# In Firefox's own browser.jar, which packaged builds already include.
browser.jar:
% content neeko %content/neeko/
    content/neeko/neeko.css (neeko.css)
    content/neeko/neeko-ui.css (neeko-ui.css)
    content/neeko/neeko-theme.css (neeko-theme.css)
    content/neeko/neeko-theme-dialog.css (neeko-theme-dialog.css)
    content/neeko/neeko-api.js (neeko-api.js)
    content/neeko/neeko-pages-process.js (neeko-pages-process.js)
