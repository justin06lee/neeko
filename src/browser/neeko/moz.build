# Neeko: hides Firefox's own UI and mounts a custom one in its place.
# Firefox builds this folder because of the one-line src/browser/moz-build.patch.

# Registers NeekoWindow on Firefox's per-window startup hook, and
# NeekoPrivacy and NeekoPages on its once-per-startup hook.
EXTRA_COMPONENTS += ["Neeko.manifest"]

MOZ_SRC_FILES += [
    "NeekoAPI.sys.mjs",
    "NeekoBookmarks.sys.mjs",
    "NeekoDownloads.sys.mjs",
    "NeekoPageChild.sys.mjs",
    "NeekoPageParent.sys.mjs",
    "NeekoPages.sys.mjs",
    "NeekoPanels.sys.mjs",
    "NeekoPrivacy.sys.mjs",
    "NeekoSettings.sys.mjs",
    "NeekoWindow.sys.mjs",
]

# chrome://neeko/content/: the stylesheets that hide Firefox's UI and help
# custom UIs, and neeko-api.js, the UI's side of the Neeko API.
JAR_MANIFESTS += ["jar.mn"]

# Installed into browser/defaults/preferences, which Firefox reads at startup.
# The "firefox-neeko" names make them win over Firefox's own firefox.js (see
# firefox-neeko.js).
JS_PREFERENCE_FILES += [
    "firefox-neeko-privacy.js",
    "firefox-neeko.js",
]
