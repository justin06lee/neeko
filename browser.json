{
  "name": "Neeko",
  "vendor": "Neeko",
  "appId": "dev.neeko.demo",
  "version": "0.20.1",
  "theme": {
    "radius": 6,
    "dialogRadius": 10,
    "light": {
      "text": "#222222",
      "muted": "#666666",
      "surface": "#ffffff",
      "line": "#cfcfd8",
      "field": "#f5f5f8",
      "primary": "#4a7dff",
      "onPrimary": "#ffffff"
    },
    "dark": {
      "text": "#dddddd",
      "muted": "#999999",
      "surface": "#22222a",
      "line": "#3a3a44",
      "field": "#26262c",
      "primary": "#4a7dff",
      "onPrimary": "#ffffff"
    }
  },
  "menus": {
    "menubar": {
      "file": [
        "newTab", "newWindow", "newPrivateWindow", "openFile", "closeTab",
        "closeWindow", "savePage", "print"
      ],
      "edit": true,
      "view": ["zoom", "fullScreen"],
      "history": true,
      "bookmarks": true,
      "window": true,
      "help": ["troubleshootingInfo"]
    },
    "context": [
      "back", "forward", "reload", "stop", "bookmarkPage", "savePage",
      "selectAll", "openLinkInTab", "openLinkInWindow",
      "openLinkInPrivateWindow", "bookmarkLink", "saveLink", "copyLink",
      "copyEmail", "copyPhone", "openImage", "saveImage", "copyImage",
      "copyImageLink", "play", "pause", "mute", "unmute", "loop", "fullScreen",
      "controls", "pictureInPicture", "saveVideo", "saveAudio",
      "copyVideoLink", "copyAudioLink", "undo", "redo", "cut", "copy", "paste",
      "delete", "revealPassword", "searchSelection", "printSelection",
      "spelling", "passwords", "pdf", "frame", "viewSourceCommands",
      "viewSource", "inspect", "extensions"
    ]
  },
  "containers": [
    {"id": "personal", "name": "Personal", "color": "#4a7dff", "default": true},
    {"id": "work", "name": "Work", "color": "#2dc653"},
    {"id": "private", "name": "Private", "color": "#9b5de5", "ephemeral": true}
  ]
}
