# Build settings shared by every platform. Surfer merges this file with
# configs/<os>/mozconfig and writes the result to engine/mozconfig.
# Surfer replaces the name, binName and appId placeholders with values from
# surfer.json.

ac_add_options --enable-application=browser

# The program stays "firefox" because artifact builds download Mozilla's
# prebuilt binaries, which carry that name. The prebuilt launcher also has
# Firefox's app name compiled in, which decides the profile folder, so these
# only name the locally built parts (see docs/plan.md).
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=${name}
ac_add_options --with-distribution-id=${appId}

# Artifact build: download Mozilla's prebuilt C++/Rust for this exact release
# and build only the frontend (JS/HTML/CSS) locally. Minutes, not hours.
# Set NEEKO_FULL_BUILD=1 to compile everything from source instead.
if test -z "$NEEKO_FULL_BUILD"; then
  ac_add_options --enable-artifact-builds

  # engine/ is a Surfer snapshot, not a Mozilla checkout, so the artifact
  # finder can't discover the revision from history. The release tarball
  # records it in sourcestamp.txt.
  NEEKO_ARTIFACT_REVISION=$(sed -n 's|.*/rev/||p' "$topsrcdir/sourcestamp.txt")
  mk_add_options "export MOZ_ARTIFACT_REVISION=$NEEKO_ARTIFACT_REVISION"
fi

# Let mach download any toolchains it needs.
ac_add_options --enable-bootstrap

# Privacy (docs/privacy/decisions.md). Artifact builds use Mozilla's prebuilt
# core, which has telemetry compiled in, so Neeko's prefs switch telemetry off
# (src/browser/neeko/firefox-neeko-privacy.js). These flags remove the
# frontend code and programs that would contact Mozilla anyway.
# No app updates from Mozilla: no update checks to aus5.mozilla.org.
ac_add_options --disable-updater
# No crash reporter: no crash reports or crash pings to Mozilla.
ac_add_options --disable-crashreporter
# Keep Firefox's telemetry build flag off even if MOZILLA_OFFICIAL is ever
# set. (It's already off in local builds and can't change the prebuilt core.)
ac_add_options MOZ_TELEMETRY_REPORTING=
